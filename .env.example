# ——— Database (Neon) ———
# App connections: use the POOLED URL (host contains "-pooler").
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/openventure?sslmode=require"
# Migrations (drizzle-kit): the DIRECT URL (no "-pooler").
DATABASE_URL_DIRECT="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/openventure?sslmode=require"

# ——— Auth ———
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The deployed URL (or http://localhost:3000 in dev)
BETTER_AUTH_URL="http://localhost:3000"

# ——— Email (Resend) ———
# Without a key, magic links/OTPs are logged to the server console (dev mode).
RESEND_API_KEY=""
# Must be a verified domain in Resend (SPF + DKIM) or deliverability will suffer.
EMAIL_FROM="Your Club <mail@yourclub.university.edu>"

# ——— Optional: LLM enrichment ———
# When set, "Enrich from website" also asks Claude for a one-liner + sector
# guess from the company's homepage text (one small call per click — roughly a
# cent each at current pricing). Unset = deterministic meta-tag enrichment only.
ANTHROPIC_API_KEY=""

# ——— Break-glass admin (leave unset normally) ———
# If the graduating cohort forgot to promote a successor: set this to the new
# officer's email, redeploy, have them sign in (they become an admin member),
# then UNSET it. See ADMIN_RUNBOOK.md → "Locked out".
BOOTSTRAP_ADMIN_EMAIL=""
