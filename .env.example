# OpenVenture environment. On Vercel these live in Project → Settings →
# Environment Variables; locally, copy this file to .env.local.
# Check a deployment any time at /api/health — it says which of these are
# missing without revealing their values.

# ——— Database (required) ———
# Any Postgres. On Vercel, adding the Neon integration (Storage → Create
# Database → Neon) sets DATABASE_URL and DATABASE_URL_UNPOOLED for you.
# The app should use the POOLED URL (host contains "-pooler").
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/openventure?sslmode=require"
# Optional: a direct (non-pooled) URL for migrations. Falls back to
# DATABASE_URL_UNPOOLED, then DATABASE_URL — so you can usually leave it out.
# DATABASE_URL_DIRECT=""

# ——— Auth ———
# Signs sessions. Any long random string (a password manager, or
# `openssl rand -base64 32`). Changing it signs everyone out.
# If you leave it unset, production derives a secret from the database
# credentials instead — safe, but rotating the database password then signs
# everyone out. There is never a built-in default.
BETTER_AUTH_SECRET=""
# The address people use to reach the app, e.g. https://grants.yourclub.org.
# Sign-in links and every link in an email are built from it.
BETTER_AUTH_URL="http://localhost:3000"

# ——— Email (needed for anyone to sign in without reading server logs) ———
# Free at resend.com. Without a key, sign-in links and all notifications are
# only written to the server log.
RESEND_API_KEY=""
# Who emails come from. Until you verify your own domain in Resend, leave this
# unset: mail then goes out from Resend's test address, which only delivers to
# the email you signed up to Resend with.
# EMAIL_FROM="Your Club <grants@yourclub.org>"

# ——— Scheduled jobs (needed for reminders, digests and auto-closing votes) ———
# Any long random string. Vercel Cron sends it automatically; on other hosts
# your cron passes it as a Bearer token (ADMIN_RUNBOOK.md → Scheduling).
# Without it the daily job refuses to run in production.
CRON_SECRET=""

# ——— Optional: sign in with a school account ———
# Email links always work. These add a button; the club stays invite-only.
# Redirect URI to register: https://your-site/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Redirect URI: https://your-site/api/auth/callback/microsoft
# All three are needed; the tenant id is your school's, never "common".
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT_ID=""

# ——— Optional: knowing when something fails ———
# A Slack-compatible webhook that is POSTed each distinct server error (with a
# short reference, never request contents).
# ERROR_WEBHOOK_URL=""
# Resend → Webhooks signing secret, for bounces and spam complaints
# (ADMIN_RUNBOOK.md → Email health). Endpoint: /api/webhooks/resend
# RESEND_WEBHOOK_SECRET=""

# ——— Optional: AI drafts ———
# Enables draft summaries, memo help and website enrichment. Everything it
# writes is an editable draft; nothing is sent or decided automatically. A club
# typically spends a few dollars a year. Unset = those buttons are hidden.
ANTHROPIC_API_KEY=""
# Ceiling on model calls per day for the whole deployment (default 150).
# AI_DAILY_LIMIT=""

# ——— Optional: AI connections (MCP) ———
# Members can connect their own AI assistant at /connect with a personal access
# token (README → Connect your AI). It is on by default and needs no setup.
# Set to 1 to switch the endpoint off for everyone.
# MCP_DISABLED=""

# ——— Optional: attachments ———
# Decks and receipts are stored in the database. Total allowed per club, in MB
# (default 250; a free Postgres tier is about 500 MB in all).
# FILE_STORAGE_LIMIT_MB=""

# ——— Optional: public demo ———
# On a database loaded with `pnpm seed:demo` ONLY: lets anyone explore the app
# read-only without signing in. Does nothing on a real club's data.
# DEMO_MODE=""

# ——— Optional: deploy behavior ———
# Set to 1 to build without applying database migrations (rarely needed).
# SKIP_DB_MIGRATE=""
# Vercel preview builds never migrate, so a pull request cannot change a
# database it shares with production. If your previews have their own database
# (Neon branching), set this to 1 for the Preview environment only.
# MIGRATE_PREVIEW=""

# ——— Break-glass admin (leave unset normally) ———
# If the graduating cohort forgot to promote a successor: set this to the new
# officer's email, redeploy, have them sign in (they become an admin member),
# then UNSET it. See ADMIN_RUNBOOK.md → "Locked out".
BOOTSTRAP_ADMIN_EMAIL=""
